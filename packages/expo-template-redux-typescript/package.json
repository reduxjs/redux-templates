{
  "name": "expo-template-redux-typescript",
  "version": "1.0.0",
  "description": "The official Redux+TS template for Expo",
  "main": "index.ts",
  "scripts": {
    "android": "expo start --android",
    "build": "expo export --platform android --output-dir build --source-maps",
    "format:check": "oxfmt --check",
    "format": "oxfmt",
    "ios": "expo start --ios",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "start": "expo start",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "web": "expo start --web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reduxjs/redux-templates.git",
    "directory": "packages/expo-template-redux-typescript"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "expo": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  }
}
